<%- include('../layouts/header') %>

<div class="max-w-4xl mx-auto space-y-10">
    <!-- Header -->
    <div class="border-b-2 border-[#111111] pb-4">
        <div class="font-mono text-xs font-bold uppercase tracking-widest text-[#6e6e6e]">
            INSTITUTIONAL SETTLEMENT // LEDGER
        </div>
        <h1 class="text-3xl font-black uppercase tracking-tight text-[#111111] mt-1">
            Digital Asset Vault &amp; Direct Transfers
        </h1>
        <p class="text-xs text-[#555555] mt-1">
            Immediate institutional settlement and peer-to-peer balance disbursements.
        </p>
    </div>

    <!-- Balance Card & Security Architecture Overview -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white border-2 border-[#111111] p-6 flex flex-col justify-between">
            <div>
                <span class="font-mono text-xs font-bold uppercase tracking-wider text-[#6e6e6e]">Available Balance</span>
                <div class="text-4xl font-black font-mono text-[#111111] mt-2">
                    $<%= Number(user.wallet_balance || 0).toFixed(2) %>
                </div>
            </div>
            <div class="font-mono text-xs text-[#6e6e6e] pt-4 border-t border-[#d8d6ce] mt-4">
                VAULT ID: <strong class="text-[#111111]"><%= user.username %></strong>
            </div>
        </div>

        <div class="md:col-span-2 bg-white border border-[#111111] p-6 flex flex-col justify-between">
            <div>
                <div class="font-mono text-xs font-bold uppercase tracking-wider text-[#111111] mb-1">
                    Direct Disbursement Protocol
                </div>
                <p class="text-xs text-[#555555] leading-relaxed">
                    All fund transfers execute as atomic SQLite transactions. In Safe Mode, requests require a cryptographically signed anti-CSRF token and strict cookie boundaries to prevent unauthorized cross-origin execution.
                </p>
            </div>
            <div class="mt-4 pt-3 border-t border-[#d8d6ce] flex items-center justify-between text-xs font-mono">
                <span class="text-[#6e6e6e]">External Simulation Portal:</span>
                <a href="http://localhost:4000/csrf-transfer.html" target="_blank" class="font-bold text-[#111111] hover:underline">
                    Trigger Cross-Origin Transfer (:4000) ↗
                </a>
            </div>
        </div>
    </div>

    <% if (error) { %>
        <div class="alert-error">
            <%= error %>
        </div>
    <% } %>

    <% if (success) { %>
        <div class="alert-success">
            <%= success %>
        </div>
    <% } %>

    <!-- Fund Transfer Form -->
    <div class="bg-white border-2 border-[#111111] p-8 space-y-6">
        <div class="border-b border-[#d8d6ce] pb-3">
            <h2 class="text-base font-black uppercase text-[#111111] tracking-tight">
                Transfer Funds to Recipient
            </h2>
            <p class="text-xs text-[#6e6e6e] font-mono mt-0.5">
                Target Action: POST /wallet/transfer
            </p>
        </div>

        <form action="/wallet/transfer" method="POST" class="space-y-4">
            <% if (isSafeMode && csrfToken) { %>
                <!-- ========================================================
                     SAFE DEFENSE: SYNCHRONIZER TOKEN PATTERN
                     A unique, cryptographically random CSRF token tied to
                     the session is embedded in the form and validated.
                     ======================================================== -->
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label for="recipient" class="block font-mono text-xs font-bold uppercase tracking-wider text-[#111111] mb-1">
                        Recipient Username
                    </label>
                    <input type="text" id="recipient" name="recipient" required
                           placeholder="e.g. bob, alice, attacker">
                </div>

                <div>
                    <label for="amount" class="block font-mono text-xs font-bold uppercase tracking-wider text-[#111111] mb-1">
                        Disbursement Amount ($ USD)
                    </label>
                    <input type="number" step="0.01" min="1" id="amount" name="amount" required
                           placeholder="e.g. 50.00">
                </div>
            </div>

            <div class="flex items-center justify-between pt-2">
                <span class="font-mono text-[11px] text-[#888888]">
                    <%= isSafeMode ? '🔒 Protected by CSRF Token + SameSite Cookie' : '⚠️ Unprotected: Ambient Session Authentication' %>
                </span>
                <button type="submit" class="btn-primary">
                    Confirm &amp; Disburse Payment →
                </button>
            </div>
        </form>
    </div>

    <!-- Recent Transactions Ledger -->
    <div class="space-y-4">
        <div class="border-b-2 border-[#111111] pb-2 flex items-baseline justify-between">
            <h2 class="text-base font-black uppercase text-[#111111] tracking-tight">
                Outbound Transaction Ledger
            </h2>
            <span class="font-mono text-xs text-[#6e6e6e]">TRANSACTION AUDIT</span>
        </div>

        <table class="store-table">
            <thead>
                <tr>
                    <th class="w-32">TX REFERENCE</th>
                    <th>RECIPIENT USERNAME</th>
                    <th class="w-36 text-right">DISBURSEMENT</th>
                    <th class="w-48 text-right">TIMESTAMP</th>
                </tr>
            </thead>
            <tbody>
                <% if (transactions && transactions.length > 0) { %>
                    <% transactions.forEach(tx => { %>
                        <tr>
                            <td class="font-mono text-xs text-[#6e6e6e] font-bold">
                                #TX-<%= tx.id %>
                            </td>
                            <td class="font-bold text-[#111111]">
                                <%= tx.receiver_username %>
                            </td>
                            <td class="font-mono text-sm font-bold text-right text-[#c92a2a]">
                                -$<%= Number(tx.amount).toFixed(2) %>
                            </td>
                            <td class="font-mono text-xs text-right text-[#6e6e6e]">
                                <%= tx.timestamp %>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="4" class="text-center py-8 font-mono text-xs text-[#6e6e6e]">
                            No previous transfer records recorded for this account.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../layouts/footer') %>
