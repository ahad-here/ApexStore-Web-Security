<%- include('../layouts/header') %>

<div class="space-y-12">
    <!-- Editorial Store Hero -->
    <section class="bg-white border border-[#111111] p-8 sm:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <div class="lg:col-span-7">
                <div class="font-mono text-xs font-bold uppercase tracking-widest text-[#6e6e6e] mb-3">
                    [EDITION 2026] // DEVELOPER HARDWARE ATELIER
                </div>
                <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-[#111111] uppercase leading-tight">
                    High-precision computing hardware designed for system engineers.
                </h1>
            </div>
            <div class="lg:col-span-5 flex flex-col justify-between space-y-6">
                <p class="text-sm text-[#3a3a3a] leading-relaxed">
                    Every device in our catalog is engineered to exact mechanical tolerances with enterprise-grade materials and verified referential data integrity. Integrated with a high-throughput digital wallet for immediate institutional settlement.
                </p>
                <div class="flex flex-wrap gap-3">
                    <a href="/catalog" class="btn-primary">Browse Full Catalog</a>
                    <a href="/wallet" class="btn-secondary">Open Digital Wallet</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Hardware Inventory Manifest -->
    <section class="space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between border-b-2 border-[#111111] pb-3 gap-3">
            <h2 class="text-lg font-black uppercase tracking-tight text-[#111111]">
                Hardware Inventory Manifest
            </h2>

            <div class="flex flex-wrap gap-2 font-mono text-xs">
                <a href="/catalog" class="px-2.5 py-1 bg-[#111111] text-white font-bold uppercase">All Hardware</a>
                <a href="/catalog?category=Electronics" class="px-2.5 py-1 border border-[#111111] hover:bg-[#111111] hover:text-white uppercase">Electronics</a>
                <a href="/catalog?category=Accessories" class="px-2.5 py-1 border border-[#111111] hover:bg-[#111111] hover:text-white uppercase">Accessories</a>
                <a href="/catalog?category=Audio" class="px-2.5 py-1 border border-[#111111] hover:bg-[#111111] hover:text-white uppercase">Audio</a>
                <a href="/catalog?category=Furniture" class="px-2.5 py-1 border border-[#111111] hover:bg-[#111111] hover:text-white uppercase">Furniture</a>
            </div>
        </div>

        <!-- Ruled Commercial Table -->
        <table class="store-table">
            <thead>
                <tr>
                    <th class="w-24">REF</th>
                    <th>SPECIFICATION &amp; BUILD DETAILS</th>
                    <th class="w-32 hidden md:table-cell">CATEGORY</th>
                    <th class="w-28 hidden sm:table-cell">AVAILABILITY</th>
                    <th class="w-32 text-right">PRICE (USD)</th>
                    <th class="w-40 text-right">DISPATCH</th>
                </tr>
            </thead>
            <tbody>
                <% if (products && products.length > 0) { %>
                    <% products.forEach(product => { %>
                        <tr>
                            <td class="font-mono text-xs text-[#6e6e6e] font-bold">
                                #DEV-00<%= product.id %>
                            </td>
                            <td>
                                <div class="font-bold text-sm text-[#111111]"><%= product.title %></div>
                                <div class="text-xs text-[#555555] line-clamp-2 mt-1"><%= product.description %></div>
                            </td>
                            <td class="font-mono text-xs text-[#555555] uppercase hidden md:table-cell">
                                <%= product.category %>
                            </td>
                            <td class="font-mono text-xs hidden sm:table-cell">
                                <span class="font-bold text-[#111111]"><%= product.stock %></span> in stock
                            </td>
                            <td class="font-mono text-sm font-bold text-right text-[#111111]">
                                $<%= Number(product.price).toFixed(2) %>
                            </td>
                            <td class="text-right">
                                <a href="/products/<%= product.id %>" class="btn-outline-sm">
                                    Specs &amp; Reviews →
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="text-center py-8 text-[#6e6e6e] font-mono text-xs">
                            No inventory items currently loaded. Please run database seeder.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </section>

    <!-- Commercial Quality Guarantees -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
        <div class="bg-white border border-[#d8d6ce] p-6">
            <div class="font-mono text-xs font-bold text-[#6e6e6e] mb-1">01 / DISPATCH</div>
            <div class="font-bold text-sm uppercase text-[#111111] mb-2">Direct Studio Shipment</div>
            <p class="text-xs text-[#555555] leading-relaxed">
                Orders placed before 16:00 CET depart same day via tracked DHL Express freight with tamper-evident packaging.
            </p>
        </div>
        <div class="bg-white border border-[#d8d6ce] p-6">
            <div class="font-mono text-xs font-bold text-[#6e6e6e] mb-1">02 / INTEGRITY</div>
            <div class="font-bold text-sm uppercase text-[#111111] mb-2">Cryptographic Receipts</div>
            <p class="text-xs text-[#555555] leading-relaxed">
                Every purchase generates a cryptographically signed transaction receipt recorded directly in your digital wallet.
            </p>
        </div>
        <div class="bg-white border border-[#d8d6ce] p-6">
            <div class="font-mono text-xs font-bold text-[#6e6e6e] mb-1">03 / WARRANTY</div>
            <div class="font-bold text-sm uppercase text-[#111111] mb-2">3-Year Studio Warranty</div>
            <p class="text-xs text-[#555555] leading-relaxed">
                Comprehensive mechanical and electrical warranty covering all developer workstation units and studio panels.
            </p>
        </div>
    </section>
</div>

<%- include('../layouts/footer') %>
