<%- include('../layouts/header') %>

<div class="max-w-xl mx-auto my-16 bg-white border-2 border-[#111111] p-8 text-center space-y-6">
    <div class="inline-block border border-[#111111] px-3 py-1 font-mono text-xs font-bold text-[#c92a2a] bg-[#fff5f5]">
        SYSTEM EXCEPTION // CODE: <%= code || 500 %>
    </div>

    <h1 class="text-2xl font-black uppercase tracking-tight text-[#111111]">
        <%= title || 'Error Encountered' %>
    </h1>

    <div class="code-box text-left">
        <div class="font-mono text-[10px] font-bold uppercase text-[#888888] mb-1">Diagnostic Notice:</div>
        <div class="text-[#c92a2a]"><%= message %></div>
    </div>

    <div class="pt-4 border-t border-[#d8d6ce]">
        <a href="/" class="btn-primary">
            ← Return to Storefront
        </a>
    </div>
</div>

<%- include('../layouts/footer') %>
